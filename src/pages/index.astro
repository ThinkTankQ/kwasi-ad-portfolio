---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Loader from '../components/Loader.astro';
import Nav from '../components/Nav.astro';
import { creativeTools, siteConfig } from '../data/site';
import { getProfileMedia, milestones, profileStory } from '../data/profile';

const projects = (await getCollection('projects')).sort((a, b) => a.data.featuredOrder - b.data.featuredOrder);
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const media = [
  { image: 'afrofuture-nigeria.jpg', label: 'Campaign worlds', meta: 'AfroFuture / Visual content', project: projects[1] },
  { image: 'aerial-collective.jpg', label: 'Air studies', meta: 'Selected film / Aerial', project: projects[2] },
  { image: 'afrofuture-ghana.jpg', label: 'Culture systems', meta: 'AfroFuture / Digital', project: projects[0] },
  { image: 'atlantic-rocks.jpg', label: 'Field notes', meta: 'Atlantic / Photography', project: projects[2] },
  { image: 'cape-town-flight.jpg', label: 'Above the city', meta: 'Cape Town / Motion', project: projects[2] },
  { image: 'afrofuture-caribbean.jpg', label: 'Crowd energy', meta: 'AfroFuture / Campaign', project: projects[1] }
];
const bookingHref = `mailto:${siteConfig.bookingEmail}?subject=${encodeURIComponent(siteConfig.bookingSubject)}`;
const collaborationHref = `mailto:${siteConfig.bookingEmail}?subject=${encodeURIComponent(siteConfig.collaborationSubject)}`;
const profileImage = (file: string, width: 720 | 1440, format: 'avif' | 'webp' | 'jpg') =>
  `${base}images/profile/${file}-${width}.${format}`;
const communityFrames = [
  getProfileMedia('generation-unlimited'),
  getProfileMedia('generation-community'),
  getProfileMedia('bica-panel')
];
---

<BaseLayout>
  <Loader />
  <Nav />

  <main id="main">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero__noise" aria-hidden="true"></div>
      <div class="hero__eyebrow">
        <span>Multidisciplinary creative</span>
        <span>Available worldwide</span>
      </div>
      <div class="hero__frame">
        <img src={`${base}images/kwasi-portrait.jpg`} alt="Portrait of Kwasi AD seated at a creative industry event" data-preload />
        <div class="hero__frame-label"><span>Portrait / 001</span><span>© KWASI AD ARCHIVE</span></div>
      </div>
      <h1 id="hero-title" class="hero__title">
        <span class="sr-only">Kwasi AD</span>
        <span aria-hidden="true">KWASI</span>
        <span aria-hidden="true">AD</span>
      </h1>
      <p class="hero__statement">Stories live between the frame<br />and the feeling.</p>
      <a class="hero__cta magnetic" href="#contact"><span>Book a project</span><b aria-hidden="true">↘</b></a>
      <div class="hero__disciplines" aria-label="Disciplines">
        {siteConfig.disciplines.map((item, index) => <span><sup>0{index + 1}</sup>{item}</span>)}
      </div>
      <div class="scroll-cue" aria-hidden="true"><span></span>Scroll to explore</div>
    </section>

    <section class="filmstrip section-dark" id="work" aria-labelledby="work-title">
      <header class="section-heading">
        <p>01 / Selected work</p>
        <h2 id="work-title">Three stories.<br />One evolving practice.</h2>
      </header>
      <div class="filmstrip__controls" aria-label="Selected work controls">
        <p><span data-rail-current>01</span> / <span>{String(projects.length).padStart(2, '0')}</span></p>
        <div>
          <button type="button" data-rail-prev aria-label="Previous project">←</button>
          <button type="button" data-rail-next aria-label="Next project">→</button>
        </div>
      </div>
      <div class="filmstrip__rail" id="filmstrip-rail" role="list" tabindex="0" aria-label="Selected project stories">
        {projects.map((project, index) => (
          <article class="project-card" role="listitem" style={`--accent:${project.data.accent}`}>
            <a href={`${base}work/${project.id}/`} aria-label={`View ${project.data.title}`}>
              <div class="project-card__image">
                <img src={`${base}${project.data.cover.replace(/^\//, '')}`} alt="" data-preload loading={index === 0 ? 'eager' : 'lazy'} />
                <span class="project-card__index">0{index + 1}</span>
                <span class="project-card__view">View story ↗</span>
              </div>
              <div class="project-card__meta">
                <h3>{project.data.title}</h3>
                <p>{project.data.role}</p>
                <p>{project.data.year}</p>
              </div>
            </a>
          </article>
        ))}
      </div>
    </section>

    <section class="collage" aria-labelledby="collage-title" data-collage>
      <div class="collage__marks" aria-hidden="true"><span>+</span><span>+</span><span>+</span><span>+</span></div>
      <header class="collage__header">
        <p>02 / Enter the archive</p>
        <p>Photography · Film · Digital</p>
      </header>
      <div class="collage__title" aria-hidden="true">
        <span>SELECTED</span><span>SELECTED</span><span>WORK</span>
      </div>
      <h2 id="collage-title" class="sr-only">Selected work archive</h2>
      <div class="collage__block" aria-hidden="true"></div>
      <div class="card-fan" role="list" aria-label="Draggable selected projects" data-card-stack>
        {media.slice(0, 5).map((item, index) => (
          <a class="fan-card" href={`${base}work/${item.project.id}/`} role="listitem" style={`--card:${index}`} data-stack-card={index}>
            <img src={`${base}images/${item.image}`} alt={`${item.label} — ${item.meta}`} loading="lazy" draggable="false" />
            <span><b>{item.label}</b><small>{item.meta}</small></span>
          </a>
        ))}
      </div>
      <div class="card-fan__controls" aria-label="Portfolio stack controls">
        <button type="button" data-stack-prev aria-label="Previous portfolio card">←</button>
        <p><span data-stack-current>03</span> / 05</p>
        <button type="button" data-stack-next aria-label="Next portfolio card">→</button>
      </div>
      <p class="collage__instruction">Drag the focused card<br />or use the arrow controls.</p>
    </section>

    <section class="constellation" aria-labelledby="constellation-title" data-constellation>
      <div class="constellation__backdrop" aria-hidden="true">
        <picture>
          <source type="image/avif" srcset={`${base}images/dronie-me-960.avif 960w, ${base}images/dronie-me-1600.avif 1600w`} sizes="100vw" />
          <source type="image/webp" srcset={`${base}images/dronie-me-960.webp 960w, ${base}images/dronie-me-1600.webp 1600w`} sizes="100vw" />
          <img src={`${base}images/dronie-me.jpg`} alt="" loading="lazy" />
        </picture>
      </div>
      <header class="constellation__header">
        <p>03 / Work constellation</p>
        <button type="button" data-archive-toggle aria-expanded="false">
          <span class="open-label">Expand archive</span><span class="close-label">Scatter archive</span><b aria-hidden="true">↗</b>
        </button>
      </header>
      <h2 id="constellation-title">A practice built<br />across formats.</h2>
      <div class="constellation__field" role="list">
        {media.map((item, index) => (
          <a
            class="orbit-item"
            href={`${base}work/${item.project.id}/`}
            role="listitem"
            style={`--x:${[10, 68, 34, 78, 18, 56][index]}%;--y:${[32, 24, 62, 68, 77, 46][index]}%;--delay:${index * -0.7}s`}
            data-orbit-item
          >
            <img src={`${base}images/${item.image}`} alt="" loading="lazy" />
            <span><b>{item.label}</b><small>{item.meta}</small></span>
          </a>
        ))}
      </div>
      <div class="creative-dock" aria-hidden="true">
        {creativeTools.map((tool) => (
          <span class:list={['tool-icon', `tool-icon--${tool.id}`]} title={tool.label}>
            <i>{tool.mark}</i>
          </span>
        ))}
      </div>
      <div class="reference-controls" aria-hidden="true">
        <span class="reference-control reference-control--expand"><i></i></span>
        <span class="reference-control reference-control--refresh"><i></i></span>
      </div>
      <p class="constellation__focus" data-constellation-focus aria-live="polite">Move through the work</p>
    </section>

    <section class="profile" id="profile" aria-labelledby="profile-title">
      <div class="profile__intro">
        <div class="profile__portrait-stack" aria-label="Portraits from the Kwasi AD archive">
          {[getProfileMedia('yellow-portrait'), getProfileMedia('monochrome-portrait')].map((image, index) => (
            <figure class:list={['profile__portrait', { 'profile__portrait--inset': index === 1 }]}>
              <picture>
                <source type="image/avif" srcset={`${profileImage(image.file, 720, 'avif')} 720w, ${profileImage(image.file, 1440, 'avif')} 1440w`} sizes={index === 0 ? '(max-width: 800px) 88vw, 38vw' : '(max-width: 800px) 42vw, 16vw'} />
                <source type="image/webp" srcset={`${profileImage(image.file, 720, 'webp')} 720w, ${profileImage(image.file, 1440, 'webp')} 1440w`} sizes={index === 0 ? '(max-width: 800px) 88vw, 38vw' : '(max-width: 800px) 42vw, 16vw'} />
                <img src={profileImage(image.file, 1440, 'jpg')} alt={image.alt} width={image.width} height={image.height} loading="lazy" style={`--focal-point:${image.focalPoint}`} />
              </picture>
              <figcaption><span>{image.caption}</span><span>© {image.credit}</span></figcaption>
            </figure>
          ))}
        </div>
        <div class="profile__copy">
          <p class="kicker">{profileStory.eyebrow}</p>
          <h2 id="profile-title">{profileStory.title}</h2>
          <p class="profile__role">Independent creative technologist<br />and visual storyteller.</p>
          <div class="profile__biography">
            {profileStory.biography.map((paragraph) => <p>{paragraph}</p>)}
          </div>
          <dl>
            <div><dt>Focus</dt><dd>Culture, music, people, place</dd></div>
            <div><dt>Instruments</dt><dd>Camera, drone, edit, interface</dd></div>
            <div><dt>Based</dt><dd>Gaborone · Working worldwide</dd></div>
          </dl>
        </div>
      </div>

      <div class="name-story" data-name-story>
        <div class="name-story__sticky">
          <p class="kicker">The name / The compass</p>
          <div class="name-story__media" aria-hidden="true">
            {profileStory.nameChapters.map((chapter, index) => {
              const image = getProfileMedia(chapter.mediaId);
              return (
                <picture class:list={['name-story__image', { 'is-active': index === 0 }]} data-story-image={index}>
                  <source type="image/avif" srcset={`${profileImage(image.file, 720, 'avif')} 720w, ${profileImage(image.file, 1440, 'avif')} 1440w`} sizes="(max-width: 800px) 100vw, 46vw" />
                  <source type="image/webp" srcset={`${profileImage(image.file, 720, 'webp')} 720w, ${profileImage(image.file, 1440, 'webp')} 1440w`} sizes="(max-width: 800px) 100vw, 46vw" />
                  <img src={profileImage(image.file, 1440, 'jpg')} alt="" width={image.width} height={image.height} loading="lazy" style={`--focal-point:${image.focalPoint}`} />
                </picture>
              );
            })}
            <span data-story-count>01 / 03</span>
          </div>
        </div>
        <ol class="name-story__chapters">
          {profileStory.nameChapters.map((chapter, index) => (
            <li class:list={['name-story__chapter', { 'is-active': index === 0 }]} data-story-step={index} tabindex="0">
              <span>{chapter.number}</span>
              <h3>{chapter.title}</h3>
              <p>{chapter.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="community" id="community" aria-labelledby="community-title" data-community>
      <header class="community__header">
        <div>
          <p class="kicker">05 / Community orbit</p>
          <h2 id="community-title">Worlds I help build.</h2>
        </div>
        <p>Creative work becomes more useful when it helps other people find knowledge, collaborators and a way in.</p>
      </header>
      <div class="community__controls" aria-label="Community story controls">
        <p><span data-community-current>01</span> / {String(milestones.length).padStart(2, '0')}</p>
        <div>
          <button type="button" data-community-prev aria-label="Previous community story">←</button>
          <button type="button" data-community-next aria-label="Next community story">→</button>
        </div>
      </div>
      <div class="community__rail" role="list" tabindex="0" data-community-rail aria-label="Community and practice milestones">
        {milestones.map((milestone) => {
          const image = getProfileMedia(milestone.mediaId);
          return (
            <article class="milestone" role="listitem">
              <figure>
                <picture>
                  <source type="image/avif" srcset={`${profileImage(image.file, 720, 'avif')} 720w, ${profileImage(image.file, 1440, 'avif')} 1440w`} sizes="(max-width: 800px) 84vw, 42vw" />
                  <source type="image/webp" srcset={`${profileImage(image.file, 720, 'webp')} 720w, ${profileImage(image.file, 1440, 'webp')} 1440w`} sizes="(max-width: 800px) 84vw, 42vw" />
                  <img src={profileImage(image.file, 1440, 'jpg')} alt={image.alt} width={image.width} height={image.height} loading="lazy" style={`--focal-point:${image.focalPoint}`} />
                </picture>
                <figcaption>{image.caption}</figcaption>
              </figure>
              <div class="milestone__body">
                <p class="milestone__period">{milestone.period}</p>
                <h3>{milestone.title}</h3>
                <p class="milestone__role">{milestone.role}</p>
                <p class="milestone__summary">{milestone.summary}</p>
                <details>
                  <summary><span>Read the story</span><b aria-hidden="true">+</b></summary>
                  <div class="milestone__detail">
                    <p>{milestone.details}</p>
                    {milestone.sources && (
                      <ul aria-label="Official sources">
                        {milestone.sources.map((source) => (
                          <li><a href={source.url} target="_blank" rel="noreferrer">{source.label} ↗</a></li>
                        ))}
                      </ul>
                    )}
                  </div>
                </details>
              </div>
            </article>
          );
        })}
      </div>
      <div class="community__frames" aria-label="Selected community moments">
        {communityFrames.map((image) => (
          <figure>
            <picture>
              <source type="image/avif" srcset={`${profileImage(image.file, 720, 'avif')} 720w, ${profileImage(image.file, 1440, 'avif')} 1440w`} sizes="(max-width: 800px) 72vw, 31vw" />
              <source type="image/webp" srcset={`${profileImage(image.file, 720, 'webp')} 720w, ${profileImage(image.file, 1440, 'webp')} 1440w`} sizes="(max-width: 800px) 72vw, 31vw" />
              <img src={profileImage(image.file, 1440, 'jpg')} alt={image.alt} width={image.width} height={image.height} loading="lazy" style={`--focal-point:${image.focalPoint}`} />
            </picture>
            <figcaption><span>{image.caption}</span><span>© {image.credit}</span></figcaption>
          </figure>
        ))}
      </div>
      <div class="community__cta">
        <p>Speaking · Workshops · Creative collaboration</p>
        <a href={collaborationHref}><span>Invite me to speak or collaborate</span><b aria-hidden="true">↗</b></a>
      </div>
    </section>

    <section class="contact" id="contact" aria-labelledby="contact-title">
      <p class="kicker">06 / New business</p>
      <h2 id="contact-title">Have a world<br />worth framing?</h2>
      <div class="focus-game" data-focus-game>
        <p class="focus-game__instruction"><span>Frame the shot</span> Move the reticle into focus, or book directly.</p>
        <div class="focus-game__stage" data-focus-stage>
          <div class="focus-reticle" data-focus-reticle aria-hidden="true"><i></i><span>AF</span></div>
          <div class="focus-game__flash" aria-hidden="true"></div>
          <a class="contact__cta" href={bookingHref}>
            <span data-focus-label>Book a project</span><b aria-hidden="true">↗</b>
          </a>
        </div>
        <p class="sr-only" role="status" aria-live="polite" data-focus-status>Booking link ready.</p>
      </div>
      <div class="contact__secondary">
        <a href={collaborationHref}>Speaking or community collaboration ↗</a>
        <a href={siteConfig.instagramUrl} target="_blank" rel="noreferrer">Prefer Instagram? Send a DM ↗</a>
      </div>
      <div class="contact__footer">
        <p>{siteConfig.name}<br /><a href={bookingHref}>{siteConfig.bookingEmail}</a></p>
        <p>Cinematography<br />Photography<br />Digital experiences</p>
        <p>Selected works archive<br />Gaborone · Worldwide</p>
      </div>
      <div class="contact__marquee" aria-hidden="true">
        <span>KWASI AD — MAKE THE MOMENT LAST — </span><span>KWASI AD — MAKE THE MOMENT LAST — </span>
      </div>
    </section>
  </main>

  <script>
    import '../scripts/site.ts';
  </script>
</BaseLayout>
