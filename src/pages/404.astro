---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
---
<BaseLayout title="Frame not found — Kwasi AD">
  <main id="main" class="not-found">
    <p>404 / Missing frame</p>
    <h1>This moment<br />escaped us.</h1>
    <a href={base}>Return to the archive ↗</a>
  </main>
</BaseLayout>
