---
import { siteConfig } from '../data/site';
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
---

<header class="site-header" data-header>
  <a class="monogram" href={base} aria-label="Kwasi AD home">K<span>AD</span></a>
  <nav aria-label="Primary navigation">
    <a href={`${base}#work`}>Work</a>
    <a href={`${base}#profile`}>Profile</a>
    <a href={`${base}#contact`}>Contact</a>
  </nav>
  <a class="availability" href={siteConfig.instagramUrl} target="_blank" rel="noreferrer">
    <i aria-hidden="true"></i>{siteConfig.availability}
  </a>
</header>
